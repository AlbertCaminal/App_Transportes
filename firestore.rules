rules_version = '2';

// Despliega con: firebase deploy --only firestore:rules
// Pruebas locales: npm run test:firestore-rules (requiere Java en PATH)
// O pega estas reglas en Firebase Console → Firestore → Reglas

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function isCarrier() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appMode == 'carrier';
    }

    // --- Solicitudes: el cliente solo crea (pending); el resto lo mueve Admin SDK (Functions). ---
    function isAnonymousSignIn() {
      return request.auth != null
        && request.auth.token is map
        && 'firebase' in request.auth.token
        && request.auth.token.firebase is map
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isPriceString(s) {
      return s is string && s.size() > 0 && s.size() <= 32 && s.matches('^[0-9]+([.][0-9]{1,2})?$');
    }

    function isTimeSlotString(s) {
      return s is string && s.size() >= 9 && s.size() <= 16 && s.matches('^[0-2][0-9]:[0-5][0-9]-[0-2][0-9]:[0-5][0-9]$');
    }

    function isPositiveMeasureCm(n) {
      return n is number && n > 0 && n <= 1000;
    }

    function isPositiveWeightKg(n) {
      return n is number && n > 0 && n <= 5000;
    }

    function expressPackageMap(m) {
      return m is map
        && m.keys().hasOnly(['lengthCm', 'widthCm', 'heightCm', 'weightKg'])
        && isPositiveMeasureCm(m.lengthCm)
        && isPositiveMeasureCm(m.widthCm)
        && isPositiveMeasureCm(m.heightCm)
        && isPositiveWeightKg(m.weightKg);
    }

    function optionalPackagePhotoUrl(p) {
      return !('packagePhotoUrl' in p)
        || (p.packagePhotoUrl is string
          && p.packagePhotoUrl.size() >= 12
          && p.packagePhotoUrl.size() <= 2048);
    }

    function packageMap(p) {
      return p is map
        && (p.keys().hasOnly(['id', 'destination', 'lengthCm', 'widthCm', 'heightCm', 'weightKg'])
          || p.keys().hasOnly([
            'id', 'destination', 'lengthCm', 'widthCm', 'heightCm', 'weightKg', 'packagePhotoUrl'
          ]))
        && p.id is string && p.id.size() > 0 && p.id.size() <= 128
        && p.destination is string && p.destination.size() > 0 && p.destination.size() <= 2000
        && isPositiveMeasureCm(p.lengthCm)
        && isPositiveMeasureCm(p.widthCm)
        && isPositiveMeasureCm(p.heightCm)
        && isPositiveWeightKg(p.weightKg)
        && optionalPackagePhotoUrl(p);
    }

    // Hasta 5 paradas con validación completa (evita superar el límite de evaluación de reglas en rechazos).
    function validProgrammedPackages(pkgs) {
      return pkgs is list && pkgs.size() >= 1 && pkgs.size() <= 5
        && packageMap(pkgs[0])
        && (pkgs.size() < 2 || packageMap(pkgs[1]))
        && (pkgs.size() < 3 || packageMap(pkgs[2]))
        && (pkgs.size() < 4 || packageMap(pkgs[3]))
        && (pkgs.size() < 5 || packageMap(pkgs[4]));
    }

    function requestCreateCommon() {
      let data = request.resource.data;
      return request.auth != null
        && !isAnonymousSignIn()
        && data.clientId == request.auth.uid
        && data.status == 'pending'
        && data.serviceType in ['express', 'programmed']
        && data.lang in ['ca', 'es', 'en']
        && data.origin is string && data.origin.size() >= 1 && data.origin.size() <= 2000
        && data.selectedDateOffset is int && data.selectedDateOffset >= 0 && data.selectedDateOffset <= 60
        && data.timeSlot is string && isTimeSlotString(data.timeSlot)
        && data.openRoutePreferred is bool
        && data.hasSimulatedMatch is bool
        && data.priceFull is string && isPriceString(data.priceFull)
        && data.priceFinal is string && isPriceString(data.priceFinal)
        && data.createdAt == request.time
        && !('carrierId' in data)
        && !('matchingStartedAt' in data)
        && !('assignedAt' in data)
        && !('cancelledAt' in data);
    }

    function requestCreateExpress() {
      let data = request.resource.data;
      return data.serviceType == 'express'
        && (data.keys().hasOnly([
          'serviceType', 'status', 'lang', 'origin', 'expressDestination', 'expressPackage',
          'selectedDateOffset', 'timeSlot', 'openRoutePreferred', 'priceFull', 'priceFinal',
          'hasSimulatedMatch', 'clientId', 'createdAt'
        ])
          || data.keys().hasOnly([
            'serviceType', 'status', 'lang', 'origin', 'expressDestination', 'expressPackage',
            'selectedDateOffset', 'timeSlot', 'openRoutePreferred', 'priceFull', 'priceFinal',
            'hasSimulatedMatch', 'clientId', 'createdAt', 'expressPackagePhotoUrl'
          ]))
        && data.expressDestination is string
        && data.expressDestination.size() >= 1
        && data.expressDestination.size() <= 2000
        && expressPackageMap(data.expressPackage)
        && !('packages' in data)
        && (!('expressPackagePhotoUrl' in data)
          || (data.expressPackagePhotoUrl is string
            && data.expressPackagePhotoUrl.size() >= 12
            && data.expressPackagePhotoUrl.size() <= 2048));
    }

    function requestCreateProgrammed() {
      let data = request.resource.data;
      return data.serviceType == 'programmed'
        && data.keys().hasOnly([
          'serviceType', 'status', 'lang', 'origin', 'packages',
          'selectedDateOffset', 'timeSlot', 'openRoutePreferred', 'priceFull', 'priceFinal',
          'hasSimulatedMatch', 'clientId', 'createdAt'
        ])
        && 'packages' in data
        && validProgrammedPackages(data.packages)
        && !('expressDestination' in data)
        && !('expressPackage' in data);
    }

    match /requests/{requestId} {
      allow create: if requestCreateCommon()
        && (
          requestCreateExpress()
          || requestCreateProgrammed()
        );

      allow read: if request.auth != null && (
        resource.data.clientId == request.auth.uid
        || ('carrierId' in resource.data && resource.data.carrierId == request.auth.uid)
        || (isCarrier() && resource.data.status == 'searching_carrier')
      );

      allow update, delete: if false;
    }
  }
}
